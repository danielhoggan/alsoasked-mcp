# AlsoAsked MCP server - environment variables
# Copy to .env (or set in your host's secret manager) and fill in real values.

# --- Required ---

# AlsoAsked API key (sent as X-Api-Key to https://alsoaskedapi.com).
# NOTE: the SoW calls this "API_KEY" but the code reads ALSOASKED_API_KEY.
ALSOASKED_API_KEY=aa-xxxx

# Shared secret MCP clients must present to the public proxy.
# Accepted as either "x-api-key: <key>" or "Authorization: Bearer <key>".
PROXY_API_KEY=

# Public base URL of this deployment, e.g. https://alsoasked-mcp.example.com
# REQUIRED on any non-Railway host: proxy.mjs exits at boot if neither this
# nor RAILWAY_PUBLIC_DOMAIN is set (it is only used for a startup log line,
# but the check is fatal).
PUBLIC_URL=

# --- Optional ---

# Port the public proxy listens on (default 8000). Railway injects this.
PORT=8000

# Set automatically by Railway; used as a fallback for PUBLIC_URL.
# RAILWAY_PUBLIC_DOMAIN=
